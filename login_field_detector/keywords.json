{
  "version": "2.1.0",
  "last_updated": "2025-01-05",
  "description": "Optimized keywords for detecting prioritized form elements and navigation.",
  "oauth_providers": [
    "google",
    "apple",
    "facebook",
    "microsoft",
    "linkedin",
    "github",
    "twitter",
    "amazon",
    "yahoo",
    "dropbox",
    "slack",
    "spotify",
    "twitch",
    "paypal",
    "salesforce",
    "reddit"
  ],
  "labels": [
    "NEXT_BUTTON",
    "SOCIAL_LOGIN_BUTTONS",
    "LOGIN_BUTTON",
    "USERNAME",
    "PASSWORD",
    "PHONE_NUMBER",
    "TWO_FACTOR_AUTH"
  ],
  "input_labels": [
    "USERNAME",
    "PASSWORD",
    "PHONE_NUMBER",
    "TWO_FACTOR_AUTH"
  ],
  "label_regexes": {
    "NEXT_BUTTON": "\\b(next\\s*(step|button|page)?|continue\\s*(to|>)?|proceed\\s*(to|>)?|advance\\s*(>)?)\\b",
    "SOCIAL_LOGIN_BUTTONS": "(?i)(login|sign in|connect|continue|authenticate)\\s*(with|via)?",
    "LOGIN_BUTTON": "(?i)(log\\s*in|sign\\s*in|sign\\s*on|access\\s*(your|the)?\\s*account|proceed to login|continue\\s*to\\s*login|submit|enter\\s*(your)?\\s*credentials|login now)",
    "USERNAME": "(?i)(e-?mail|email\\s*address|phone|user(?:name)?|login(?:\\s*name)?|account(?:\\s*name)?|identifier|profile(?:\\s*name)?)\\b",
    "PASSWORD": "(?i)(pass(?:word)?|pwd|secret|security(?:\\s*word|\\s*code)?|key|pin|access\\s*code|passphrase)",
    "PHONE_NUMBER": "(?i)(phone|mobile(?:\\s*number)?|contact\\s*number|cell|telephone|call(?:\\s*us)?)|\\+?[\\d\\s-]{7,15}",
    "TWO_FACTOR_AUTH": "(?i)(2fa|authenticator|verify(?:\\s*code)?|verification(?:\\s*code)?|token|otp|one(?:\\s*time)?\\s*code|security(?:\\s*key)?|two(?:\\s*step)?(?:\\s*verification)?)\\b"
  },
  "spinner_patterns": [
    "spinner",
    "loading",
    "progress-bar",
    "ant-spin",
    "mat-spinner",
    "busy",
    "fa-spin",
